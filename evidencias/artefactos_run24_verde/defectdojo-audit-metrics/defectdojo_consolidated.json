      "cvssv4_score": null,
      "url": "https://avd.aquasec.com/misconfig/ksv-0020",
      "severity": "Low",
      "description": "**Target:** kubernetes/deployment.yaml\n**Type:** Kubernetes Security Check\n\nForce the container to run with user ID > 10000 to avoid conflicts with the host’s user table.\nContainer 'insegus-microservice' of Deployment 'insegus-microservice-deployment' should set 'securityContext.runAsUser' > 10000\nNumber\tContent\n32\t      - name: insegus-microservice\n33\t        image: ghcr.io/luiguiram/insegus-microservice:1.1.0\n34\t        imagePullPolicy: Always\n35\t        ports:\n36\t        - containerPort: 3000\n37\t        securityContext:\n38\t          privileged: false\n39\t          allowPrivilegeEscalation: false\n40\t          readOnlyRootFilesystem: true\n41\t\n\n",
      "mitigation": "Set 'containers[].securityContext.runAsUser' to an integer > 10000.",
      "fix_available": true,
      "fix_version": null,
      "impact": "Force the container to run with user ID > 10000 to avoid conflicts with the host’s user table.",
      "steps_to_reproduce": null,
      "severity_justification": null,
      "references": "https://avd.aquasec.com/misconfig/ksv-0020\nhttps://kubesec.io/basics/containers-securitycontext-runasuser/",
